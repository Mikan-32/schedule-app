# ===== PC の通知（Bot 不要。Windows・Mac・Linux） =====
# 以前の名前（WINDOWS_NOTIFICATIONS・WINDOWS_NOTIFY_APPS など）もそのまま使えます
# auto = Windows・Mac・Linux なら有効 / true / false
NOTIFICATIONS=auto
# 監視するアプリ（表示名・アプリID の部分一致、カンマ区切り）。例: Discord,Slack,Teams,Zoom,LINE
NOTIFY_APPS=Discord
# 読み取り方式。auto = OS ごとに使えるものを順に試す
#   Windows: 通知API（winrt）→ 通知データベース（database） / Mac: 通知データベース / Linux: D-Bus
NOTIFY_BACKEND=auto
NOTIFY_POLL_SEC=2
# 起動時に、直近何分以内の通知までさかのぼって精査するか
NOTIFY_BACKFILL_MIN=30

# ===== Discord Bot（任意） =====
# Discord Developer Portal で作成した Bot のトークン。DM 通知・確認ボタン・画像の精査に使う
DISCORD_BOT_TOKEN=
# 通知を受け取るあなたの Discord ユーザーID（開発者モードで右クリック→「ユーザーIDをコピー」）
DISCORD_OWNER_ID=
# 監視するチャンネルID（カンマ区切り）。空なら Bot が見えるすべてのチャンネル
DISCORD_WATCH_CHANNEL_IDS=
# false = Bot はチャンネルを読まず、DM 通知の送信だけ行う（PC の通知で読む場合の二重処理防止）
DISCORD_READ_CHANNELS=true

# ===== ローカルLLM (Ollama) =====
# auto = Windows・Mac・Linux ではアプリに同梱の Ollama を使う（初回起動時に自動で用意。別途インストール不要）
# embedded = 同梱の Ollama / external = 自分でインストールした Ollama（OLLAMA_BASE_URL）を使う
LLM_RUNTIME=auto
# 同梱の Ollama のバージョン・ポート（別途インストールした Ollama の 11434 とは別）
EMBEDDED_OLLAMA_VERSION=v0.40.2
EMBEDDED_OLLAMA_PORT=11435
# 同梱の Ollama にモデルがないとき、最初に用意するモデル
EMBEDDED_MODEL=qwen3-vl:8b-instruct
# auto = NVIDIA のドライバーがあれば GPU 用のライブラリも用意し、なければ内蔵 GPU（Intel Arc など。Vulkan）を使う
# cpu = GPU を使わない / nvidia（Windows・Linux。Mac は Apple シリコンなら自動で GPU を使う）
EMBEDDED_GPU=auto
# LLM_RUNTIME=external のときの接続先
OLLAMA_BASE_URL=http://localhost:11434
# auto = インストール済みモデルから精度の高い順に自動選択。固定したい場合はモデル名（例: qwen3-vl:8b-instruct）
OLLAMA_MODEL=auto
OLLAMA_VISION_MODEL=auto
# 思考モード対応モデルで思考させるか（精度↑ / 速度↓）
LLM_THINK=false
LLM_TIMEOUT=300
# 画像付きの精査の待ち時間（秒）。GPU を使えない PC だと画像 1 枚で 3〜4 分かかる
LLM_IMAGE_TIMEOUT=900
# ローカルLLM が一度に読める長さ（トークン）。画像 1 枚のプロンプトで約 3,600
LLM_NUM_CTX=8192
# この確信度未満の予定は登録しない (0〜1)
MIN_CONFIDENCE=0.5
# 日付・時刻らしき表現がないメッセージは LLM に送らない
PREFILTER=true

# ===== 重複判定 =====
# overlap = 同日かつ時間帯が重なるとき確認 / same_day = 同日に予定があれば必ず確認
CONFLICT_MODE=overlap
# 終了時刻が不明な予定の長さ（分）
DEFAULT_DURATION_MIN=60

# ===== 予定の変更・取り消し =====
# auto_if_clear = 対象の予定がはっきりしていて確信度も高ければ自動で反映、あいまいなら「確認待ち」へ
# confirm = 常に確認してから反映 / auto = 常に自動で反映（変更後の日時に別の予定がある場合だけ確認）
# 自動で反映したものも、通知の「元に戻す」で取り消せます
CHANGE_MODE=auto_if_clear
# auto_if_clear のとき、この確信度以上なら自動で反映 (0〜1)
CHANGE_AUTO_CONFIDENCE=0.8

# ===== 文脈・自分宛ての判定 =====
# あなたの名前（表示名・ニックネームなど、メンションや呼びかけで使われるもの。カンマ区切り）
MY_NAMES=
# 同じチャンネル（DM は相手ごと）の直前のメッセージを、何件・何分前までLLM に参考として渡すか
CONTEXT_MESSAGES=8
CONTEXT_MINUTES=180
# あなたが所属しているグループ・ロール・チーム（@students-2026 など。カンマ区切り）。ここ宛ての連絡は「全員・グループ宛て」
MY_GROUPS=
# 宛先ごとの扱い: add = 登録 / confirm = 確認待ちに入れる / skip = 登録せず通知に残す（「自分の予定として追加する」で登録できる）
# Web UI の「登録の基準」（右上の設定ボタン）で保存すると、そちらが優先される
AUDIENCE_ME=add
AUDIENCE_ALL=confirm
AUDIENCE_UNKNOWN=confirm
# 他の人宛て（はっきり他の人・他のグループだけの予定）
OTHERS_MODE=skip

# ===== 取りこぼし対策 =====
# ローカルLLM で精査できなかったメッセージを何秒ごとに再精査するか
QUEUE_RETRY_SEC=60
# LLM の応答エラーなどで何回失敗したらあきらめるか（接続できないだけなら数えない）
QUEUE_MAX_ATTEMPTS=3
# アプリ実行中のスリープ防止（Windows・Mac・Linux）: ac = 電源接続中だけ / always / off
PREVENT_SLEEP=ac
LOG_FILE=data/app.log

# ===== Google カレンダー同期（README の「6. Google カレンダーと同期する」参照） =====
# auto = data/google/credentials.json があれば有効 / true / false
GOOGLE_CALENDAR=auto
GOOGLE_CREDENTIALS=data/google/credentials.json
GOOGLE_TOKEN=data/google/token.json
GOOGLE_CALENDAR_NAME=スケジュール（自動登録）
# 時刻のある予定の何分前にスマホへ通知するか（0 で通知なし）
GOOGLE_REMINDER_MIN=30
GOOGLE_SYNC_SEC=60

# ===== その他 =====
TIMEZONE=Asia/Tokyo
HOST=127.0.0.1
PORT=8000
DB_PATH=data/schedule.db
